{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/drain-progress",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/cleanup-progress",
      "schedule": "0 3 * * *"
    }
  ]
}
